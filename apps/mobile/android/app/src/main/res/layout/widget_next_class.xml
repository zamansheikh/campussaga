<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget, full size (4 x 2): the next class, and the next test
     or deadline at the bottom. Texts and visibility are set by
     NextClassWidget.kt; colors follow the phone's light/dark theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: badge, "NEXT CLASS", status pill. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_icon_bg"
            android:importantForAccessibility="no"
            android:padding="5dp"
            android:src="@drawable/ic_widget_school"
            android:tint="@color/widget_accent" />

        <TextView
            android:id="@+id/class_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="@string/widget_next_class"
            android:textAllCaps="true"
            android:textColor="@color/widget_text2"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pill_now"
            style="@style/WidgetPill"
            android:background="@drawable/widget_pill_now"
            android:textColor="@color/widget_on_accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pill_soft"
            style="@style/WidgetPill"
            android:background="@drawable/widget_pill_soft"
            android:textColor="@color/widget_accent" />
    </LinearLayout>

    <!-- The class. -->
    <TextView
        android:id="@+id/class_course"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/class_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text2"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/class_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_clock"
            android:tint="@color/widget_accent" />

        <TextView
            android:id="@+id/class_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/class_room_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_place"
            android:tint="@color/widget_accent" />

        <TextView
            android:id="@+id/class_room"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <!-- Moved / extra class tag. -->
        <TextView
            android:id="@+id/class_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_warn"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/widget_warn"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- While the class runs: progress and time left. -->
    <LinearLayout
        android:id="@+id/class_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/class_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress" />

        <TextView
            android:id="@+id/class_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_text2"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Spacer (widgets allow only some view types: not a plain View). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="6dp" />

    <!-- Next test or deadline: one line. -->
    <LinearLayout
        android:id="@+id/test_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_icon_bg"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:src="@drawable/ic_widget_test"
            android:tint="@color/widget_accent" />

        <TextView
            android:id="@+id/test_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/test_sub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/test_when"
            style="@style/WidgetPill"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_soft"
            android:textColor="@color/widget_accent" />
    </LinearLayout>
</LinearLayout>
