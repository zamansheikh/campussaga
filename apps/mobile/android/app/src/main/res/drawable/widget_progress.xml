<?xml version="1.0" encoding="utf-8"?>
<!-- Class progress while it runs. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="3dp" /><solid android:color="@color/widget_accent_soft" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><corners android:radius="3dp" /><solid android:color="@color/widget_accent" /></shape></clip>
    </item>
</layer-list>
