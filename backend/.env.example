# Copy to .env for local overrides (git-ignored). Every value has a
# development default; production sets all of these in deploy/.env.
# APP_ENV=development
# ADDR=:8090
# DATABASE_URL=postgres://campus:campus@localhost:55632/campus?sslmode=disable
# JWT_SECRET=          # production: 48+ random chars (openssl rand -base64 48)
# CODE_HMAC_SECRET=    # production: different 48+ random chars
# SMTP_HOST=localhost  # production: smtp.resend.com
# SMTP_PORT=55625      # production: 587
# SMTP_USERNAME=       # production: resend
# SMTP_PASSWORD=       # production: Resend API key
# MAIL_FROM=Campus Saga <no-reply@campussaga.local>
