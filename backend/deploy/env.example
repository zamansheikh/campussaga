# Copy to /opt/campussaga/deploy/.env on the VPS, chmod 600. Never commit the real file.
APP_ENV=production
POSTGRES_PASSWORD=            # openssl rand -base64 36
DATABASE_URL=postgres://campus:<POSTGRES_PASSWORD>@postgres:5432/campus?sslmode=disable
JWT_SECRET=                   # openssl rand -base64 64
CODE_HMAC_SECRET=             # openssl rand -base64 64 (different from JWT_SECRET)
# Campus Voice: keys the per-issue anonymous handles. Required in production;
# never reuse another secret. Changing it only changes handles on new comments.
VOICE_HMAC_SECRET=            # openssl rand -base64 64
# Issue photos (the media volume in compose.yaml).
MEDIA_DIR=/data/media
# Or keep photos on Nimbus (capi.tecsior.com, R2): its API key, from the
# Nimbus dashboard. Set = photos go there instead of MEDIA_DIR.
NIMBUS_API_KEY=
# NIMBUS_URL=https://capi.tecsior.com/api/v1
# NIMBUS_PREFIX=campussaga/voice/
# Photo check (the nsfw service; compose.yaml sets NSFW_URL for the API).
# Scores 0..1: refuse at NSFW_REJECT, hold for a moderator at NSFW_HOLD.
# NSFW_REJECT=0.98
# NSFW_HOLD=0.70
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=                # Resend API key
MAIL_FROM=VarsityKotha <no-reply@silifton.com>   # silifton.com is verified in Resend
FIREBASE_PROJECT_ID=varsitykotha    # Firebase project; enables Google sign-in
# Push notifications: Firebase service-account key, mounted read-only from
# /opt/campussaga/deploy/secrets/ (see docs/DEPLOYMENT.md). Unset or missing
# file = notifications are only logged.
FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json
